# Copy this file to `.env` (same folder). It is read automatically when the server starts — locally just
# run `npm run dev:all` (project root) or `npm start` (here). When hosting, set these in the host's dashboard instead.

# The admin password. Default on localhost is admin123 — set your own here. REQUIRED (and long!) before hosting.
ADMIN_PASSWORD=change-me-to-a-long-password

# Address of your public website. Shows a "View site" button in the admin and is optional.
SITE_URL=https://your-website.example.com

# Which websites may read /api/content. `*` = any site. Safer: your real site address(es), comma-separated.
ALLOWED_ORIGINS=*

# Public address of THIS admin server (used to build full image links for uploaded photos).
# Usually not needed — it is detected automatically. Set it if images show wrong addresses behind a proxy.
# PUBLIC_URL=https://your-admin-server.example.com

# Where content, uploads and backups are stored. When hosting, point this at a PERSISTENT disk / volume.
# DATA_DIR=/var/data

# Set to 1 when the server sits behind a proxy (Render, Railway, Nginx, Cloudflare…).
# TRUST_PROXY=1

# Optional: fixed secret for login tokens (a random one is created and saved in DATA_DIR otherwise).
# SESSION_SECRET=

# PORT=4000
