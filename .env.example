# Copy this file to `.env.production` (or set the variable in your host's dashboard, e.g. Netlify / Vercel)
# BEFORE running `npm run build`.
#
# Address of the admin server's public content endpoint. The website fetches its menu, gallery, FAQs and
# contact details from here. Leave it empty to use only the content bundled inside the site.
VITE_CONTENT_URL=https://your-admin-server.example.com/api/content
